# Template: deploy/install.sh fills in the @...@ values and writes the result to
# /etc/systemd/system/family-chalk-planner.service. Don't copy this file by hand.
[Unit]
Description=Family Chalk Planner (family wall calendar)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@APP_DIR@
# Where it listens and keeps its data: family-chalk-planner.service.d/server.conf (written by install.sh).
# Every other setting lives in the board's database (admin console → ⚙️ Board). An old .env is read
# once on the first start of 0.7+ and moved into the database; the leading - means it's optional.
EnvironmentFile=-@ENV_FILE@
# (Node's note that its built-in SQLite is "experimental" on every start is left out of the log)
ExecStart=@NODE@ --disable-warning=ExperimentalWarning @APP_DIR@/server/chalkboard.js
Restart=on-failure
RestartSec=2
# Sandboxing lives in family-chalk-planner.service.d/hardening.conf (added where supported)

[Install]
WantedBy=multi-user.target
