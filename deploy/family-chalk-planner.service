# Template: deploy/install.sh fills in the @...@ values and writes the result to
# /etc/systemd/system/family-chalk-planner.service. Don't copy this file by hand.
[Unit]
Description=Family Chalk Planner (family wall calendar)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@ENV_FILE@
ExecStart=@NODE@ @APP_DIR@/server/chalkboard.js
Restart=on-failure
RestartSec=2
# Sandboxing lives in family-chalk-planner.service.d/hardening.conf (added where supported)

[Install]
WantedBy=multi-user.target
