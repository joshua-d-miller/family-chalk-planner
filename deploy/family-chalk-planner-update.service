# Template: deploy/install.sh fills in the @...@ values. "Update now" in the admin console: the board writes
# @DATA_DIR@/update-request, family-chalk-planner-update.path sees it and starts this, which runs
# deploy/update.sh as root (the board itself never runs as root).
[Unit]
Description=Family Chalk Planner: update (asked for in the admin console)

[Service]
Type=oneshot
ExecStart=/bin/bash @APP_DIR@/deploy/update.sh --from-board
TimeoutStartSec=30min
