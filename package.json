  "description": "A chalkboard-style family wall calendar: CalDAV events, chalk art, photos, meal plan and reward jars, edited from a tablet.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "server/main.ts",
  "scripts": {
    "start": "node server/chalkboard.js",
    "test": "node --test test/*.test.ts",
