# Family Chalk Planner settings.
# The installer copies this to .env in the same folder (root-only, git-ignored).
# After editing:  systemctl restart family-chalk-planner

# --- Board ---
BOARD_TITLE="Family Chalk Planner"
# Timezone the calendar is shown in (IANA name, e.g. America/Chicago, Europe/London)
TIMEZONE=America/New_York
# Sign-in: open /admin and create the admin account with the one-time setup code (printed by
# the installer, in the log and in data/setup-code.txt). Screens are paired from the admin
# console; people sign in with a passkey or password + authenticator app. Nobody can sign in
# any more? deploy/reset-admin.sh
#
# The board's https:// address (through a reverse proxy such as Nginx Proxy Manager).
# Needed for passkeys (Face ID / Touch ID / fingerprint) and for invite links.
#PUBLIC_URL=https://board.example.com
# Let unpaired devices VIEW the board without pairing (home network only):
#ALLOW_UNPAIRED_VIEW=true

# --- Calendar (any CalDAV server: iCloud, Nextcloud, Fastmail, Radicale...) ---
# iCloud: CALDAV_URL=https://caldav.icloud.com/ , your Apple ID email, and an
# app-specific password from account.apple.com (Sign-In and Security -> App-Specific Passwords).
CALDAV_URL=https://caldav.icloud.com/
CALDAV_USER=
CALDAV_PASSWORD=
# The calendar's display name exactly as it appears in your calendar app
CALDAV_CALENDAR="Family"

# --- Or: Google Calendar (instead of CalDAV) ---
# Step-by-step in docs/google-calendar.md. With these set, connect and pick the calendar
# from the tablet (⚙ Settings); the CALDAV_* lines above are then ignored.
#CALENDAR_PROVIDER=google
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
# Only with an HTTPS address and a "Web application" client (otherwise leave unset):
#GOOGLE_REDIRECT_URI=https://board.example/oauth/google/callback

# --- Notes column ---
# Weather (Open-Meteo, no key needed). Leave empty to hide weather.
LATITUDE=
LONGITUDE=
TEMP_UNIT=fahrenheit
# Starting trash pickup day: 0=Sunday ... 6=Saturday. Leave empty to hide.
# Change it (and set up recycling: same day, every other week, or its own day) on the tablet in ⚙ Settings.
TRASH_DAY=
# Holidays shown on the board (never added to your calendar): us or none
HOLIDAYS=us

# --- Photos (optional) ---
# The share link of an iCloud Shared Album (with "Public Website" on) or a Google Photos
# shared album (Share -> Create link). Step-by-step: docs/photos.md
PHOTO_ALBUM_URL=

# --- Server ---
PORT=3002
BIND=0.0.0.0

# Where the database, caches and backups live (default: data/ inside this folder)
#DATA_DIR=
# Nightly database snapshots + uploaded GIFs (defaults to DATA_DIR/backup)
#BACKUP_DIR=
# Link to the source code shown in the app (AGPL). Change it if you run a modified copy.
#SOURCE_URL=
# Behind a reverse proxy: the proxy's address, so the board trusts only it for the visitor's
# address and https (the console's Security tab shows the address it sees). Unset = any
# address on your local network is trusted.
#TRUST_PROXY=192.168.1.10
# deploy/update.sh: "release" (default) installs the newest tagged release; "main" follows
# every change on the main branch (for people working on the board).
#UPDATE_CHANNEL=release
